# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local a GitHub.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude (solo servidor: no lleva el prefijo NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Opcional: URL pública del sitio (para los enlaces de acceso por email).
# En local no hace falta; en Vercel pon la URL definitiva, p. ej. https://mahaia.vercel.app
NEXT_PUBLIC_SITE_URL=
